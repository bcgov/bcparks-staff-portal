FROM mcr.microsoft.com/devcontainers/javascript-node:4-24

# Dev-only CLI tools: GitHub CLI + Postgres client
RUN mkdir -p -m 755 /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh postgresql-client \
  && rm -rf /var/lib/apt/lists/*

# /app is a host bind mount with a different owner; let git (and gh) operate on it
RUN git config --system --add safe.directory /app

# CMD is overridden by docker-compose.dev.yml (sleep infinity),
# but the rest of this file is still used to build the dev container

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 8100

# Command to run the application
CMD ["npm", "run", "dev"]
